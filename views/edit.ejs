<% layout("/boilerplate")%>
<body>
<div class="container mt-5">
<% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<h1 class="mb-4">Make New Listing</h1>
<form method="post" action="/listings/<%=list._id%>?_method=PUT">
    <div class="mb-3">
        <label for="title">Title</label>
        <input id="title" type="text" name="listing[title]" value="<%=list.title%>" class="form-control">
    </div>
    <div class="mb-3">
        <label for="price">Price</label>
        <input id="price" type="text" name="listing[price]" value="<%=list.price%>" class="form-control">
    </div>
    <div class="mb-3">
        <label for="description">Description</label>
        <textarea id="description" name="listing[description]" class="form-control"><%=list.description%></textarea>
    </div>
    <div class="mb-3">
        <label for="image-url">Image URL</label>
        <input id="image-url" type="text" name="listing[image][url]" value="<%=list.image.url%>" class="form-control">
    </div>
    <div class="mb-3">
        <label for="location">Location</label>
        <input id="location" type="text" name="listing[location]" value="<%=list.location%>" class="form-control">
    </div>
    <div class="mb-3">
        <label for="country">Country</label>
        <input id="country" type="text" name="listing[country]" value="<%=list.country%>" class="form-control">
    </div>
    <button type="submit" class="btn btn-primary">Confirm Listing</button>
</form>
</div>
</body>