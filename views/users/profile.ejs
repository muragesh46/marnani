<% layout("/boilerplate")%>

    <style>
        .profile-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 24px;
        }

        .profile-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            padding: 48px;
            color: white;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
        }

        .profile-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            animation: pulse 4s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            font-weight: 800;
            color: white;
            margin-bottom: 20px;
            border: 5px solid rgba(255, 255, 255, 0.3);
            z-index: 2;
            position: relative;
        }

        .profile-name {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 8px;
            z-index: 2;
            position: relative;
        }

        .profile-email {
            font-size: 1.1rem;
            opacity: 0.9;
            z-index: 2;
            position: relative;
        }

        .profile-tabs {
            display: flex;
            gap: 16px;
            margin-bottom: 32px;
            border-bottom: 2px solid var(--border-color);
        }

        .profile-tab {
            padding: 16px 32px;
            background: transparent;
            border: none;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-secondary);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
            position: relative;
            bottom: -2px;
        }

        .profile-tab.active {
            color: var(--text-main);
            border-bottom-color: #667eea;
        }

        .profile-tab:hover {
            color: var(--text-main);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        .profile-card {
            background: white;
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            margin-bottom: 24px;
        }

        .profile-card h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 24px;
            color: var(--text-main);
        }

        .form-group-profile {
            margin-bottom: 24px;
        }

        .form-group-profile label {
            display: block;
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        .form-group-profile input {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.2s ease;
        }

        .form-group-profile input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        }

        .btn-update {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 14px 32px;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

        .listings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
            margin-top: 24px;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-secondary);
        }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 16px;
            opacity: 0.3;
        }

        .empty-state h4 {
            font-size: 1.3rem;
            margin-bottom: 8px;
        }

        .empty-state p {
            font-size: 1rem;
        }

        .stat-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            border-radius: 16px;
            padding: 24px;
            color: white;
        }

        .stat-card:nth-child(2) {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .stat-card:nth-child(3) {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 0.95rem;
            opacity: 0.9;
        }
    </style>

    <div class="profile-container">
        
        <div class="profile-header">
            <div class="profile-avatar">
                <%= user.username.charAt(0).toUpperCase() %>
            </div>
            <h1 class="profile-name">
                <%= user.username %>
            </h1>
            <p class="profile-email">
                <%= user.email %>
            </p>
        </div>

        
        <div class="stat-cards">
            <div class="stat-card">
                <div class="stat-number">
                    <%= userListings.length %>
                </div>
                <div class="stat-label">My Listings</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="wishlist-count">0</div>
                <div class="stat-label">Wishlisted</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">
                    <% let totalReviews=userListings.reduce((acc, l)=> acc + (l.reviews ? l.reviews.length : 0), 0); %>
                        <%= totalReviews %>
                </div>
                <div class="stat-label">Reviews Received</div>
            </div>
        </div>

        
        <div class="profile-tabs">
            <button class="profile-tab active" onclick="showTab('settings')">
                <i class="fa-solid fa-gear"></i> Settings
            </button>
            <button class="profile-tab" onclick="showTab('listings')">
                <i class="fa-solid fa-home"></i> My Listings
            </button>
            <button class="profile-tab" onclick="showTab('wishlist')">
                <i class="fa-solid fa-heart"></i> Wishlist
            </button>
        </div>

        
        <div class="tab-content active" id="settings-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="profile-card">
                        <h3>Edit Profile</h3>
                        <form action="/user/profile/update" method="POST">
                            <div class="form-group-profile">
                                <label for="username">Username</label>
                                <input type="text" id="username" name="username" value="<%= user.username %>" required>
                            </div>
                            <div class="form-group-profile">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" value="<%= user.email %>" required>
                            </div>
                            <button type="submit" class="btn-update">
                                <i class="fa-solid fa-save"></i> Update Profile
                            </button>
                        </form>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="profile-card">
                        <h3>Change Password</h3>
                        <form action="/user/profile/password" method="POST">
                            <div class="form-group-profile">
                                <label for="currentPassword">Current Password</label>
                                <input type="password" id="currentPassword" name="currentPassword" required>
                            </div>
                            <div class="form-group-profile">
                                <label for="newPassword">New Password</label>
                                <input type="password" id="newPassword" name="newPassword" required minlength="6">
                            </div>
                            <div class="form-group-profile">
                                <label for="confirmPassword">Confirm New Password</label>
                                <input type="password" id="confirmPassword" name="confirmPassword" required
                                    minlength="6">
                            </div>
                            <button type="submit" class="btn-update">
                                <i class="fa-solid fa-lock"></i> Change Password
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="tab-content" id="listings-tab">
            <% if (userListings.length> 0) { %>
                <div class="listings-grid">
                    <% for (let listing of userListings) { %>
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <div class="card listing-card">
                                <div class="image-wrapper">
                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image"
                                        style="height: 16rem">
                                </div>
                                <div class="card-body">
                                    <h5 class="listing-title">
                                        <%= listing.title %>
                                    </h5>
                                    <p class="listing-location">
                                        <%= listing.location %>, <%= listing.country %>
                                    </p>
                                    <p class="listing-price">
                                        <% if (listing.price) { %>
                                            &#8377;<%= listing.price.toLocaleString("en-IN") %> <span
                                                    style="font-weight: 400">night</span>
                                                <% } %>
                                    </p>
                                    <% if (listing.reviews && listing.reviews.length> 0) { %>
                                        <% let sum=listing.reviews.reduce((acc, r)=> acc + r.rating, 0); %>
                                            <% let avg=(sum / listing.reviews.length).toFixed(1); %>
                                                <div class="listing-rating">
                                                    <i class="fa-solid fa-star"></i>
                                                    <span>
                                                        <%= avg %>
                                                    </span>
                                                </div>
                                                <% } %>
                                </div>
                            </div>
                        </a>
                        <% } %>
                </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fa-solid fa-home"></i>
                        <h4>No Listings Yet</h4>
                        <p>Start hosting by creating your first listing!</p>
                        <a href="/listings/new" class="btn-update"
                            style="display: inline-block; margin-top: 20px; text-decoration: none;">Create Listing</a>
                    </div>
                    <% } %>
        </div>

        
        <div class="tab-content" id="wishlist-tab">
            <div id="wishlist-container">
                <div class="listings-grid" id="wishlist-grid">
                    
                </div>
                <div class="empty-state" id="wishlist-empty" style="display: none;">
                    <i class="fa-solid fa-heart"></i>
                    <h4>No Wishlisted Properties</h4>
                    <p>Start adding properties to your wishlist by clicking the heart icon!</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showTab(tabName) {

            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });


            document.querySelectorAll('.profile-tab').forEach(btn => {
                btn.classList.remove('active');
            });


            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');


            if (tabName === 'wishlist') {
                loadWishlist();
            }
        }


        function loadWishlist() {
            const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
            const wishlistGrid = document.getElementById('wishlist-grid');
            const wishlistEmpty = document.getElementById('wishlist-empty');
            const wishlistCount = document.getElementById('wishlist-count');

            wishlistCount.textContent = wishlist.length;

            if (wishlist.length === 0) {
                wishlistGrid.innerHTML = '';
                wishlistEmpty.style.display = 'block';
                return;
            }

            wishlistEmpty.style.display = 'none';


            Promise.all(wishlist.map(id =>
                fetch(`/listings/${id}`)
                    .then(r => r.text())
                    .then(html => {

                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        return { id, exists: doc.querySelector('.listing-title-main') !== null };
                    })
                    .catch(() => ({ id, exists: false }))
            )).then(results => {

                const validWishlist = results.filter(r => r.exists).map(r => r.id);
                if (validWishlist.length !== wishlist.length) {
                    localStorage.setItem('wishlist', JSON.stringify(validWishlist));
                    wishlistCount.textContent = validWishlist.length;
                }


                if (validWishlist.length === 0) {
                    wishlistEmpty.style.display = 'block';
                } else {
                    wishlistGrid.innerHTML = `
                    <div class="empty-state">
                        <i class="fa-solid fa-heart"></i>
                        <h4>${validWishlist.length} Properties Saved</h4>
                        <p>Visit the <a href="/listings">listings page</a> to view your wishlisted properties!</p>
                    </div>
                `;
                }
            });
        }


        document.addEventListener('DOMContentLoaded', () => {
            const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
            document.getElementById('wishlist-count').textContent = wishlist.length;
        });
    </script>