<% layout("/boilerplate") %>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 text-center">
                <div class="error-container">
                    <h1 class="error-code">Oops!</h1>
                    <h2 class="error-message">
                        <%= message || "Something went wrong" %>
                    </h2>
                    <p class="error-description">
                        We can't seem to find the page you're looking for, or an unexpected error occurred.
                    </p>
                    <% if (process.env.NODE_ENV !=="production" && error) { %>
                        <div class="alert alert-danger text-start mt-4" role="alert">
                            <h5 class="alert-heading">Error Details:</h5>
                            <pre><%= error.stack %></pre>
                        </div>
                        <% } %>
                            <a href="/listings" class="btn btn-primary mt-4">Back to Home</a>
                </div>
            </div>
        </div>
    </div>